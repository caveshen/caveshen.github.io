---
// Badger.astro — commissioned Badger avatar, full rights (not the inspiration-only decal).
// Same x/y/scale contract as HoodedFigure.astro: local y=196 is the ground/shoe line, so
// callers pass the figure's own FIG anchors straight through.
// Treatment: grayscale + contrast, darker at night, so the raster doesn't out-detail the
// flat-silhouette world.
// Raster size: 200 is SVG units, not pixels — do not resize the 500×500 source down; it's
// already tight at the top of the range (≈1024 device px at 2560/2×).
// Two-frame idle: swaps on --badger-cadence (800ms/frame, 1.6s cycle), CSS-only;
// prefers-reduced-motion holds the up frame.
interface Props {
  x: number;
  y: number;
  scale?: number;
}
const { x, y, scale = 1 } = Astro.props;
---

<g class="js-character badger-figure" transform={`translate(${x},${y}) scale(${scale})`}>

  <!-- ground shadow — identical form to the hooded figure's own -->
  <ellipse cx="0" cy="196" rx="50" ry="11" fill="rgba(0,0,0,0.35)"/>

  <!-- up painted first, down on top; CSS swaps opacity, shadow/position shared -->
  <image class="badger-image badger-up"   href="/badger-up.png"   x="-100" y="-4" width="200" height="200" />
  <image class="badger-image badger-down" href="/badger-down.png" x="-100" y="-4" width="200" height="200" />

  <!-- invisible marker over the face — drives approach/zoom framing, same as .face-void -->
  <rect class="face-void" x="-42" y="34" width="84" height="66" fill="transparent" />

  <!-- Generous invisible hit surface — figure bounds (x:-100..100, y:-4..196)
       plus comfortable padding. Painted last so it sits topmost and owns the
       whole padded area's hover/click, not just the drawn silhouette. Never
       focusable — see .js-character-hit in Stage.astro (pointer-events:all,
       cursor:pointer) and stage.js (hover summons the approach prompt; a
       click or tap starts the dialogue directly, same as the prompt). -->
  <rect class="js-character-hit" x="-120" y="-20" width="240" height="230" fill="transparent" />

</g>

<style is:global>
  /* ponytail: --badger-cadence is the single timing constant; retunable here */
  :root { --badger-cadence: 800ms; }

  .badger-image {
    filter: grayscale(1) contrast(1.05) brightness(.95);
  }
  :root:not([data-time="day"]) .badger-image {
    filter: grayscale(1) contrast(1.05) brightness(.95) brightness(.7);
  }

  /* up shows first half of cycle, down second half; steps(1, end) = hard-cut, no cross-fade */
  @keyframes badger-up {
    0%   { opacity: 1; animation-timing-function: steps(1, end); }
    50%  { opacity: 0; animation-timing-function: steps(1, end); }
    100% { opacity: 1; }
  }
  @keyframes badger-down {
    0%   { opacity: 0; animation-timing-function: steps(1, end); }
    50%  { opacity: 1; animation-timing-function: steps(1, end); }
    100% { opacity: 0; }
  }

  .badger-up   { animation: badger-up   calc(var(--badger-cadence) * 2) linear infinite; }
  .badger-down { animation: badger-down calc(var(--badger-cadence) * 2) linear infinite; }

  @media (prefers-reduced-motion: reduce) {
    .badger-up   { animation: none; opacity: 1; }
    .badger-down { animation: none; opacity: 0; }
  }
</style>
