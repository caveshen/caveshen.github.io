---
// BadgerHead.astro — the sculpted head, inlined so token-class fills resolve; sizing is the caller's.
import svgSource from '../assets/badger-head.svg?raw';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Fragment set:html={svgSource.replace('<svg ', `<svg class="${className ?? ''}" `)} />
