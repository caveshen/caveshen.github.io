---
// CityScape.astro — the world (landforms + city bowl + lit windows), authored once,
// rendered into all three scene SVGs at variant-appropriate camera transforms (pan +
// scale only, never a stretch). Fills are CSS classes — var() doesn't resolve in SVG
// presentation attributes.

interface Props {
  camera: string; // e.g. "translate(0,128)" or "translate(-20,262) scale(0.62)"
}
const { camera } = Astro.props;

const BUILDINGS: Array<[number, number, number, number]> = [
  // city breathing left, wrapping around the mountain's foot
  [46, 304, 26, 48], [78, 284, 30, 68], [114, 298, 24, 54], [144, 270, 32, 82], [176, 290, 20, 62],
  // the shipped city bowl
  [190, 230, 34, 122], [232, 258, 26, 94], [266, 209, 40, 143], [314, 271, 28, 81],
  [350, 225, 36, 127], [394, 282, 24, 70], [426, 198, 44, 154], [478, 249, 30, 103],
  [516, 220, 38, 132], [562, 276, 26, 76], [596, 236, 42, 116], [646, 263, 30, 89],
  [684, 217, 36, 135], [728, 279, 26, 73], [766, 268, 32, 84], [806, 287, 24, 65],
  // industrial district — harbour end, west of the mountain foot (x<40).
  // Plain rects, same f-near language as the buildings: two portal cranes (legs/boom/cable/
  // hook), two stepped container clusters.
  [-58, 330, 20, 22], [-36, 330, 20, 22], [-14, 330, 20, 22], [-49, 306, 20, 24], [-27, 306, 20, 24], [-40, 282, 20, 24], // containers, cluster 1 — taller stepped stack beside crane B
  [-118, 178, 7, 174], [-78, 178, 7, 174], [-140, 172, 110, 8], [-38, 180, 3, 50], [-44, 230, 15, 9], // crane B: legs, boom, cable, hook
  [-18, 168, 7, 184], [22, 168, 7, 184], [-42, 162, 110, 8], [60, 170, 3, 55], [54, 225, 15, 9], // crane A: legs, boom, cable, hook
  [-16, 330, 20, 22], [6, 330, 20, 22], [-7, 306, 20, 24], // containers, cluster 2 — taller stepped stack under crane A
];

// Industrial district, warehouse-fringe half — further west, lower, and its own
// paler f-fringe tone (a third distance step past f-far) so density recedes toward the frame edge.
const INDUSTRIAL_FAR: Array<[number, number, number, number]> = [
  [-293, 336, 24, 16], // shed A body
  [-273, 268, 9, 84],  // chimney stack
  [-247, 290, 24, 20], [-245, 310, 4, 42], [-225, 310, 4, 42], // water tower: tank, legs
  [-213, 318, 46, 34], // shed B body
  [-175, 326, 40, 26], // shed C body
];

// Lit windows: base opacity is the artwork's own (--o); glimmer only ever dips below it,
// on a per-window duration/delay so nothing pulses in unison. Emitted inline at build time
// so this stays CSS-only and works with JS disabled.
const WINDOWS: Array<[number, number, number]> = [
  [54, 318, 0.6], [86, 298, 0.8], [122, 312, 0.5], [152, 286, 0.75], [152, 318, 0.45], [182, 304, 0.65],
  [198, 247, 0.85], [212, 276, 0.55], [274, 225, 0.9], [290, 260, 0.6], [298, 295, 0.75], [358, 241, 0.8],
  [372, 282, 0.5], [436, 214, 0.9], [452, 249, 0.65], [444, 303, 0.75], [486, 268, 0.55], [524, 236, 0.85],
  [540, 279, 0.6], [606, 252, 0.8], [620, 293, 0.5], [692, 233, 0.85], [706, 276, 0.6], [774, 284, 0.7],
  // industrial fringe — sparse, dim: industry is darker than the city bowl
  [-195, 330, 0.35], [-160, 336, 0.3],
];
const windowStyle = (opacity: number, i: number) => {
  const t = (4.5 + ((i * 1.7) % 6.5)).toFixed(2);
  const d = -((i * 2.3) % 9);
  return `--o:${opacity};--t:${t}s;--d:${d.toFixed(2)}s;`;
};

// Idle drift (stage.js) shifts .bg-layer up to DRIFT_MAX=2.5 units; extending
// baseline-touching shapes this far below y=352 keeps the sea (fg-layer, painted
// over) covering the seam across the full excursion. See docs/PRD.md d28.
const BASELINE_Y = 352;
const SEAM_MARGIN = 6;
const withSeamMargin = (y: number, h: number) => (y + h === BASELINE_Y ? h + SEAM_MARGIN : h);
---

<g class="world" transform={camera}>
  <!-- Devil's Peak — painted first so Table Mountain's own polygon
       overlaps and masks its right-flank descent into the saddle -->
  <!-- Baseline vertices (y=352) are overscanned to y=358 (SEAM_MARGIN) so idle
       drift never opens a sky gap at the waterline — see withSeamMargin above. -->
  <polygon class="f-far" points="-80,358 70,95 200,124 240,358" />
  <!-- lit/shade facets, cut against the light source (upper-right, matching the
       celestial disc): a vertical split through the apex, not a full reshape -->
  <polygon class="f-mtn-shade" points="-80,358 70,95 70,358" />
  <polygon class="f-mtn-lit" points="70,95 200,124 240,358 70,358" />
  <polygon class="f-far table-mountain"
           points="40,358 130,187 190,120 230,109 300,104 480,106 540,114 585,167 640,358" />
  <polygon class="f-mtn-shade" points="40,358 130,187 190,120 190,358" />
  <polygon class="f-mtn-lit" points="480,106 540,114 585,167 640,358 480,358" />
  <!-- Kloof Nek — a raised col bridging Table Mountain's foot to Lion's Head's,
       so the join reads as a mountain pass rather than an open drop to the city -->
  <polygon class="f-far" points="615,358 648,272 675,272 705,358" />
  <!-- Lion's Head — closes the gap to Table Mountain, apex softened -->
  <polygon class="f-far" points="695,358 785,201 795,156 803,151 811,156 825,201 915,358" />
  <!-- Signal Hill — keeps the mountain chain linked -->
  <polygon class="f-far" points="850,358 892,306 944,272 1000,260 1056,272 1108,306 1150,358" />
  <!-- warehouse fringe — low pitched-roof sheds, water tower, chimney; tapers off westward -->
  <g class="f-fringe">
    <polygon points="-295,336 -281,320 -267,336" />
    <polygon points="-216,318 -190,296 -164,318" />
    <polygon points="-178,326 -155,310 -132,326" />
    {INDUSTRIAL_FAR.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={withSeamMargin(y, h)} />)}
  </g>
  <g class="f-near">
    {BUILDINGS.map(([x, y, w, h]) => (
      <>
        <rect x={x} y={y} width={w} height={withSeamMargin(y, h)} />
        <!-- side-face strip, left edge (light from upper-right): capped well under
             the 6-unit minimum window inset (see WINDOWS below) so glow never floats
             over it -->
        <rect x={x} y={y} width={Math.min(4, w * 0.3)} height={withSeamMargin(y, h)} class="f-bld-shade" />
      </>
    ))}
  </g>
  <g class="f-cel night-only">
    {WINDOWS.map(([x, y, o], i) => (
      <rect x={x} y={y} width="4" height="6" opacity={o} style={windowStyle(o, i)} />
    ))}
  </g>
</g>
