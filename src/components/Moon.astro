---
// Moon.astro — the pale/cratered night moon (PRD §14: radius locked at 46 in
// every view; PRD §30 D-1), authored ONCE and rendered into all three scene
// SVGs at variant-appropriate centres. The 4 craters used to be hand-computed
// absolute coordinates redone by hand per variant — they are now offsets from
// the moon's own centre, so nobody ever redoes that arithmetic again.
//
// Fills are CSS classes, not presentation attributes — var() does not resolve
// inside SVG presentation attributes (PRD constraint).

interface Props {
  cx: number;
  cy: number;
}
const { cx, cy } = Astro.props;
---

<circle class="f-moon" cx={cx} cy={cy} r="46" />
<g class="f-crater" opacity="0.55">
  <circle cx={cx - 16} cy={cy - 14} r="8" />
  <circle cx={cx + 17} cy={cy + 14} r="5.5" />
  <circle cx={cx + 9} cy={cy - 22} r="3.5" />
  <circle cx={cx - 22} cy={cy + 16} r="4.5" />
</g>
