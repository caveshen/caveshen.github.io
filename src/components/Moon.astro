---
// Moon.astro — the pale/cratered night moon, authored once, rendered into all
// three scene SVGs at variant-appropriate centres. Crater offsets below are
// relative to the moon's own centre, not absolute, so placement isn't redone
// per variant. Radius is 95% of the sun's (Scene.astro's day-only `.f-cel`,
// r=50); crater offsets/radii are scaled to match. Fills are CSS classes —
// var() does not resolve inside SVG presentation attributes.

interface Props {
  cx: number;
  cy: number;
}
const { cx, cy } = Astro.props;
---

<circle class="f-moon" cx={cx} cy={cy} r="47.5" />
<g class="f-crater" opacity="0.55">
  <circle cx={cx - 16.5} cy={cy - 14.5} r="8.3" />
  <circle cx={cx + 17.6} cy={cy + 14.5} r="5.7" />
  <circle cx={cx + 9.3} cy={cy - 22.7} r="3.6" />
  <circle cx={cx - 22.7} cy={cy + 16.5} r="4.6" />
</g>
