---
// Scene.astro — the scene backdrop, rendered per aspect variant; numbers that
// only differ by variant live in the VARIANT data table below, not duplicated
// markup. Character arrives as a prop, not a slot — Astro slots take no props,
// and per-variant placement (fig, below) can't be hand-tuned at the call site.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import CityScape from './CityScape.astro';
import Moon from './Moon.astro';

interface Props {
  variant: 'standard' | 'wide' | 'tall';
  character?: AstroComponentFactory;
  characterLabel?: string;
}
const { variant, character: Character, characterLabel = '' } = Astro.props;

// One world, three cameras — pan + uniform scale only, never a stretch.
// Foreground (stars/sun/sea/waves/rail/figure) is free to differ per view.
const VARIANT = {
  standard: {
    width: 1200, height: 750,
    ariaBase: "Cape Town's Table Mountain, Lion's Head and Signal Hill above the city bowl",
    camera: 'translate(0,128)',
    celestial: { cx: 930, cy: 150 },
    // Clustered stars (mock vignette B): three knots plus a sparse scatter.
    stars: [
      [288, 62, 1.1, .8], [310, 96, .7, .45], [339, 48, .9, .65], [362, 114, 1.2, .9],
      [386, 74, .6, .35], [405, 132, .8, .5], [424, 56, 1.0, .7], [450, 100, .7, .4],
      [471, 144, 1.1, .75], [326, 154, .6, .3],
      [662, 68, 1.0, .7], [688, 116, .7, .45], [716, 52, 1.2, .85], [741, 94, .6, .35],
      [766, 138, .9, .6], [794, 76, .7, .5], [821, 122, 1.1, .8], [846, 44, .6, .3],
      [702, 156, .8, .4],
      [1046, 64, .9, .6], [1072, 108, .7, .45], [1098, 50, 1.1, .8], [1124, 92, .6, .35],
      [1152, 130, 1.0, .7], [1178, 60, .8, .55],
      [95, 70, 1.6, .8], [150, 230, 1.0, .35], [560, 190, .6, .3], [240, 160, 1.0, .35], [900, 190, 1.2, .5],
    ],
    // Four-point sparkle marks, gold-bright: [cx, cy, arm length].
    sparkles: [[480, 82, 12], [776, 128, 14], [1052, 80, 12], [1128, 172, 10]],
    dayClouds: [
      [120, 140, 150, 22, 11, .85], [620, 105, 110, 20, 10, .7],
    ],
    sea: { y: 480, height: 120 },
    // Broken glint column: tapering dashes centred under the moon's x.
    glint: [
      [913, 502, 34, .55], [916, 508, 28, .5], [919, 514, 22, .44], [921, 520, 18, .38],
      [924, 527, 15, .32], [917, 534, 20, .3], [926, 541, 12, .26], [923, 548, 14, .22],
    ],
    waves: [
      [70, 500, 38, .16], [260, 524, 30, .12], [430, 548, 44, .14], [610, 508, 32, .1], [760, 560, 36, .13], [1080, 534, 28, .11],
    ],
    // Day-only sails on the bay: [foot x, foot y, size scale].
    sails: [{ x: 250, y: 552, s: 1 }, { x: 318, y: 560, s: .72 }],
    ground: { y: 600, height: 150 },
    rail: { y1: 590, y2: 654, topY: 592, botY: 624, posts: [40, 200, 360, 520, 680, 840, 1000, 1160] },
    fig: { x: 700, y: 700 - 196 * 1.2, scale: 1.2 },
  },
  wide: {
    width: 1750, height: 750,
    ariaBase: 'Cape Town skyline panorama',
    camera: 'translate(280,128)',
    celestial: { cx: 1290, cy: 150 },
    stars: [
      [388, 62, 1.1, .8], [410, 96, .7, .45], [439, 48, .9, .65], [462, 114, 1.2, .9],
      [486, 74, .6, .35], [505, 132, .8, .5], [524, 56, 1.0, .7], [550, 100, .7, .4],
      [571, 144, 1.1, .75], [426, 154, .6, .3],
      [1062, 68, 1.0, .7], [1088, 116, .7, .45], [1116, 52, 1.2, .85], [1141, 94, .6, .35],
      [1166, 138, .9, .6], [1194, 76, .7, .5], [1221, 122, 1.1, .8], [1246, 44, .6, .3],
      [1102, 156, .8, .4],
      [1546, 64, .9, .6], [1572, 108, .7, .45], [1598, 50, 1.1, .8], [1624, 92, .6, .35],
      [1652, 130, 1.0, .7], [1678, 60, .8, .55],
      [95, 70, 1.6, .8], [240, 230, 1.1, .45], [860, 190, 1.2, .5], [700, 60, 1.4, .7], [1350, 200, 1.0, .35],
    ],
    sparkles: [[580, 82, 12], [1176, 128, 14], [1552, 80, 12]],
    dayClouds: [
      [250, 140, 150, 22, 11, .85], [900, 105, 110, 20, 10, .7], [1480, 185, 130, 20, 10, .75],
    ],
    // Wide shares Standard's camera height, so sea/promenade/rail y-values match —
    // kept as separate literals; not worth abstracting two variants for three fields.
    sea: { y: 480, height: 120 },
    glint: [
      [1273, 502, 34, .55], [1276, 508, 28, .5], [1279, 514, 22, .44], [1281, 520, 18, .38],
      [1284, 527, 15, .32], [1277, 534, 20, .3], [1286, 541, 12, .26], [1283, 548, 14, .22],
    ],
    waves: [
      [90, 502, 42, .15], [340, 530, 30, .11], [610, 550, 46, .14], [830, 508, 34, .1], [1080, 560, 38, .13], [1480, 534, 30, .12],
    ],
    sails: [{ x: 420, y: 552, s: 1 }, { x: 492, y: 560, s: .72 }],
    ground: { y: 600, height: 150 },
    rail: { y1: 590, y2: 654, topY: 592, botY: 624, posts: [40, 200, 360, 520, 680, 840, 1000, 1160, 1320, 1480, 1640] },
    fig: { x: 1290, y: 700 - 196 * 1.2, scale: 1.2 },
  },
  tall: {
    width: 600, height: 1067,
    ariaBase: 'Cape Town skyline in portrait',
    camera: 'translate(-20,262) scale(0.62)',
    celestial: { cx: 452, cy: 200 },
    // Tall's sky band is shallower on screen (camera scale 0.62), so clusters
    // sit tighter and the scatter stays clear of the ridge tops.
    stars: [
      [86, 88, 1.1, .8], [104, 128, .7, .45], [126, 72, .9, .65], [148, 152, 1.2, .9],
      [170, 100, .6, .35], [192, 176, .8, .5], [214, 80, 1.0, .7],
      [300, 96, 1.0, .7], [322, 140, .7, .45], [344, 68, 1.2, .85], [368, 112, .6, .35],
      [392, 158, .9, .6], [416, 92, .7, .5],
      [500, 84, .9, .6], [522, 126, .7, .45], [546, 66, 1.1, .8], [570, 108, .6, .35], [586, 148, 1.0, .7],
      [40, 260, 1.1, .45], [280, 220, 1.0, .35], [180, 290, 1.2, .5], [520, 250, .8, .4], [350, 40, .9, .55],
    ],
    sparkles: [[214, 110, 11], [368, 140, 12], [522, 100, 10]],
    dayClouds: [
      [60, 270, 130, 20, 10, .85], [300, 360, 100, 18, 9, .7],
    ],
    sea: { y: 480, height: 220 },
    glint: [
      [435, 496, 34, .55], [438, 504, 28, .5], [441, 512, 22, .44], [443, 520, 18, .38],
      [446, 529, 15, .32], [439, 538, 20, .3], [448, 547, 12, .26], [445, 556, 14, .22], [447, 566, 10, .18],
    ],
    waves: [
      [40, 500, 30, .15], [150, 560, 26, .11], [90, 620, 34, .13], [260, 500, 24, .1], [320, 650, 30, .14], [180, 680, 22, .09],
    ],
    sails: [{ x: 120, y: 600, s: 1 }, { x: 186, y: 612, s: .72 }],
    ground: { y: 700, height: 367 },
    rail: { y1: 690, y2: 756, topY: 692, botY: 726, posts: [30, 150, 270, 390, 510] },
    fig: { x: 300, y: 940 - 196 * 1.3, scale: 1.3 },
  },
} as const;

const v = VARIANT[variant];
const ariaLabel = characterLabel
  ? `${v.ariaBase}, by night or day, with ${characterLabel}`
  : `${v.ariaBase}, by night or day`;

// Paving seams: evenly spaced, not hand-placed per variant like the rail posts —
// there's nothing variant-specific about a seam interval, so one formula covers all three.
const SEAM_SPACING = 70;
const seamXs = Array.from(
  { length: Math.floor(v.width / SEAM_SPACING) },
  (_, i) => SEAM_SPACING / 2 + i * SEAM_SPACING
);
---
<svg class={`scene scene-${variant}`} viewBox={`0 0 ${v.width} ${v.height}`} preserveAspectRatio="xMidYMax slice" role="img"
     aria-label={ariaLabel}>
  <defs>
    <!-- userSpaceOnUse so these read in the same coordinate space CityScape's polygons are
         authored in, not each shape's own bbox — one set of numbers works for every variant.
         Stop colour comes from the CSS classes in tokens.css, never a presentation attribute. -->
    <linearGradient id={`sky-grad-${variant}`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2={v.sea.y}>
      <stop class="stop-sky-top" offset="0" />
      <stop class="stop-sky-bottom" offset="1" />
    </linearGradient>
    <!-- 220→352: the lower third of the mountains' authored height, 352 being the shared
         baseline (CityScape.astro) where they meet the sea. -->
    <linearGradient id={`far-grad-${variant}`} gradientUnits="userSpaceOnUse" x1="0" y1="220" x2="0" y2="352">
      <stop class="stop-far-top" offset="0" />
      <stop class="stop-far-bottom" offset="1" />
    </linearGradient>
    <!-- objectBoundingBox (the default) so the halo just sizes to whatever circle it's
         painted on — same disc geometry in every variant, only the id needs suffixing. -->
    <radialGradient id={`sun-glow-${variant}`}>
      <stop class="stop-sun-glow" offset="0" stop-opacity="0.35" />
      <stop class="stop-sun-glow" offset="1" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`moon-glow-${variant}`}>
      <stop class="stop-moon-glow" offset="0" stop-opacity="0.18" />
      <stop class="stop-moon-glow" offset="1" stop-opacity="0" />
    </radialGradient>
    <!-- sun disc: solid out to offset 0.81 (≈ the old r=50 edge, on the enlarged r=62
         circle below) so the softened rim adds bloom rather than shrinking the disc,
         then fades to blend into f-sun-glow (already painted behind, r=135). -->
    <radialGradient id={`sun-core-${variant}`}>
      <stop class="stop-sun-glow" offset="0" stop-opacity="1" />
      <stop class="stop-sun-glow" offset="0.81" stop-opacity="1" />
      <stop class="stop-sun-glow" offset="1" stop-opacity="0" />
    </radialGradient>
    <!-- promenade depth falloff: darker toward the viewer (the rail end reads as
         further away, same recession logic as the sky/far-mountain haze above) -->
    <linearGradient id={`ground-grad-${variant}`} gradientUnits="userSpaceOnUse"
                     x1="0" y1={v.ground.y} x2="0" y2={v.ground.y + v.ground.height}>
      <stop class="stop-ground-top" offset="0" />
      <stop class="stop-ground-bottom" offset="1" />
    </linearGradient>
  </defs>
  <rect class="f-sky" width={v.width} height={v.height} />
  <g class="bg-layer">
  <g class="f-star night-only">
    {v.stars.map(([cx, cy, r, o]) => <circle cx={cx} cy={cy} r={r} opacity={o} />)}
  </g>
  <!-- four-point sparkle marks, gold-bright at low opacity (mock vignette B) -->
  <g class="f-sparkle night-only" opacity="0.4">
    {v.sparkles.map(([x, y, len]) => (
      <path d={`M${x} ${y - len / 2} v${len} M${x - len / 2} ${y} h${len}`} />
    ))}
  </g>
  <!-- moon (night): halo rings behind the radial glow, cloud bank seated over
       the disc's lower edge so the moon reads as set into cloud -->
  <g class="night-only">
    <circle class="f-halo" cx={v.celestial.cx} cy={v.celestial.cy} r="74" opacity="0.04" />
    <circle class="f-halo" cx={v.celestial.cx} cy={v.celestial.cy} r="58" opacity="0.06" />
    <circle class="f-moon-glow" cx={v.celestial.cx} cy={v.celestial.cy} r="128" />
    <Moon cx={v.celestial.cx} cy={v.celestial.cy} />
    <g class="f-cloudbank">
      <rect x={v.celestial.cx - 80} y={v.celestial.cy + 31} width="160" height="13" rx="6.5" />
      <rect x={v.celestial.cx - 14} y={v.celestial.cy + 49} width="96" height="9" rx="4.5" opacity="0.6" />
    </g>
  </g>
  <!-- sun + clouds (day) -->
  <g class="day-only">
    <circle class="f-sun-glow" cx={v.celestial.cx} cy={v.celestial.cy} r="135" />
    <circle class="f-cel" cx={v.celestial.cx} cy={v.celestial.cy} r="62" />
    {v.dayClouds.map(([x, y, w, h, rx, o]) => <rect x={x} y={y} width={w} height={h} rx={rx} fill="#fff" opacity={o} />)}
  </g>
  <CityScape camera={v.camera} />
  </g>
  <g class="fg-layer">
  <rect class="f-sea" y={v.sea.y} width={v.width} height={v.sea.height} />
  <g class="f-moon night-only">
    {v.glint.map(([x, y, w, o]) => <rect x={x} y={y} width={w} height="3" rx="1.5" opacity={o} />)}
  </g>
  <!-- wave marks: sparse, static, sea-toned — visible day and night -->
  {v.waves.map(([x, y, w, o]) => <rect class="f-wave" x={x} y={y} width={w} height="2" rx="1.5" opacity={o} />)}
  <!-- two small sails on the bay, day only -->
  <g class="f-sail day-only">
    {v.sails.map(({ x, y, s }) => (
      <polygon points={`${x},${y} ${x},${y - 26 * s} ${x + 17 * s},${y - 4 * s}`} />
    ))}
  </g>
  <!-- the near shore — promenade the figure stands on -->
  <rect class="f-ground" y={v.ground.y} width={v.width} height={v.ground.height} />
  <!-- paving seams: sparse, low-opacity, stay clear of the wind motes (DOM overlay,
       not SVG) and the figure's own ground shadow (HoodedFigure/Badger, painted later) -->
  <g class="f-seam" opacity="0.14">
    {seamXs.map((x) => <line x1={x} y1={v.ground.y} x2={x} y2={v.ground.y + v.ground.height} />)}
    <line x1="0" y1={v.ground.y + v.ground.height * 0.4} x2={v.width} y2={v.ground.y + v.ground.height * 0.4} />
  </g>
  <!-- rail contact shadows: post ellipses plus a thin band under the rail run itself,
       painted under the rail so it sits on top of its own shadow. The band sits a couple
       units below the posts' foot line — close enough to read as one surface, clear of
       the paving-seam crease a few units further down. -->
  <g class="f-rail-shadow">
    {v.rail.posts.map((x) => <ellipse cx={x} cy={v.rail.y2} />)}
    <rect x="0" y={v.rail.y2 + 2} width={v.width} height="3" />
  </g>
  <!-- semi-foreground railing: in front of the water, behind the figure -->
  <g class="f-rail" stroke-linecap="round" stroke-width="7">
    <g stroke-width="5">
      {v.rail.posts.map((x) => <line x1={x} y1={v.rail.y1} x2={x} y2={v.rail.y2} />)}
    </g>
    <line x1="0" y1={v.rail.topY} x2={v.width} y2={v.rail.topY} />
    <line x1="0" y1={v.rail.botY} x2={v.width} y2={v.rail.botY} stroke-width="4" opacity="0.8" />
  </g>
  {Character && <Character x={v.fig.x} y={v.fig.y} scale={v.fig.scale} />}
  </g>
</svg>

<style>
  /* Shared once here, not duplicated per caller. */
  .scene-wide, .scene-tall { display: none; }
  @media (min-aspect-ratio: 15/8) {
    .scene-standard { display: none; }
    .scene-wide { display: block; }
  }
  @media (max-aspect-ratio: 4/5) {
    .scene-standard { display: none; }
    .scene-tall { display: block; }
  }
</style>
