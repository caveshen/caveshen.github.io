---
// Stage.astro — the approach interaction: frame, camera, prompt and card. The
// paired src/scripts/stage.js does all DOM lookups via generic selectors, but
// the markup itself isn't fully route-agnostic: tree, character,
// characterLabel and promptLabel vary by route (props below); the noscript
// note is a slot since it's markup, not a value. index.astro owns the
// <script> that calls initStage(tree).
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Scene from './Scene.astro';
import Avatar from './Avatar.astro';

interface Props {
  tree: { root: { stage?: string; speech: string } };
  character: AstroComponentFactory;
  characterLabel?: string;
  promptLabel: string;
}
const { tree, character: Character, characterLabel = '', promptLabel } = Astro.props;
const root = tree.root;
---
<!--
  stage-frame: a full-height stage — a place to stand in, not a letterbox strip.
  overflow:hidden clips the camera zoom; .camera carries the transform.
  The dialogue card lives inside it as an in-scene overlay.
-->
<div class="stage-frame">
<div class="camera">

<!-- Only the variant differs per call. -->
<Scene variant="standard" character={Character} characterLabel={characterLabel} />
<Scene variant="wide" character={Character} characterLabel={characterLabel} />
<Scene variant="tall" character={Character} characterLabel={characterLabel} />

</div><!-- /.camera -->

<!-- wind: motes on the breeze, deliberately outside .camera so the breeze stays a
     constant speed when the camera pushes in. -->
<div class="wind" aria-hidden="true">
  <span class="mote" style="top:44%;animation-duration:17s;animation-delay:0s"></span>
  <span class="mote" style="top:62%;animation-duration:21s;animation-delay:-6s;width:4px;height:4px"></span>
  <span class="mote" style="top:53%;animation-duration:14s;animation-delay:-10s;width:6px;height:6px"></span>
  <span class="mote" style="top:73%;animation-duration:24s;animation-delay:-3s;width:4px;height:4px"></span>
  <span class="mote" style="top:35%;animation-duration:19s;animation-delay:-14s"></span>
</div>

<!--
  Approach prompt: a real <button> styled as a videogame NPC interaction prompt.
  Hidden by default (revealed by JS on init); JS also hides it after approach.
  Position is approximate right-foreground; JS places it near the measured figure.
-->
<button class="approach-prompt" id="approach-prompt" hidden>
  <!-- B6's idle bob animates this inner span, not the button — see .prompt-label below. -->
  <span class="prompt-label">{promptLabel}</span>
</button>

<!-- Card ships hidden so it is never painted before JS runs.
     noscript overrides [hidden] with display:block for the no-JS path. -->
<noscript><style>.card[hidden] { display: block; }</style></noscript>
<main class="card" hidden>
  <div class="card-head">
    <Avatar />
    <span class="name">Caveshen</span>
  </div>
  <!-- Static root content for no-JS path; engine overwrites on init -->
  <p class="stage" id="stage">{root.stage}</p>
  <div aria-live="polite">
    <p class="speech" id="speech">{root.speech}</p>
  </div>
  <ul class="choices" id="choices"></ul>
  <!--
    End dialogue: hidden by default (JS reveals on approach, hides on exit).
    Styled like the .system options. With JS off this stays hidden — no camera
    to exit, so no exit control needed in the no-JS path.
  -->
  <button class="end-dialogue" id="end-dialogue" hidden>PLACEHOLDER: End dialogue ✕</button>
  <slot />
</main>

<!--
  Fullscreen toggle lives INSIDE .stage-frame, not as a body-level sibling like
  ThemeToggle — the Fullscreen API only keeps descendants of the fullscreened
  element visible/interactive, so it must be one to stay clickable.
  Hidden by default; JS unhides it only if the Fullscreen API is usable, so a
  no-JS or unsupported-API visitor never sees a dead button.
-->
<button class="fullscreen-toggle" id="fullscreen-toggle" hidden aria-label="Enter fullscreen">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 9V4H9M15 4H20V9M20 15V20H15M9 20H4V15" />
  </svg>
</button>

</div><!-- /.stage-frame -->

<p class="page-foot">PLACEHOLDER — attribution line. All copy is placeholder; the real script is Caveshen's to write.</p>

<style is:global>
  /* ponytail: stage-frame is position:relative which makes it a positioned element
     that stacks AFTER the toggle (which comes earlier in DOM), so stage-frame's
     bounding box physically covers the toggle area and intercepts its clicks.
     pointer-events:none on stage-frame makes it fully transparent to events;
     interactive children (approach prompt, card) re-enable them individually. */
  .stage-frame {
    position: relative;
    overflow: hidden;
    pointer-events: none;
    /* Full-window is the default, not a toggle — nothing to centre once the
       frame always fills the viewport. Each scene's own
       preserveAspectRatio="xMidYMax slice" crops rather than stretches, so any
       window shape renders a correctly proportioned crop. 100svh (not 100vh)
       for dynamic-toolbar safety. */
    width: 100%;
    height: 100svh;
    margin: 0;
    border-radius: 0;
    border: none;
    background: var(--sky);
    transition: background 0.4s ease, border-color 0.4s ease;
  }
  .camera {
    transform-origin: 0 0;
    will-change: transform;
    height: 100%;
    transition: transform 950ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .camera { transition: none; }
  }

  .wind { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .mote {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mote);
    opacity: 0;
    animation: drift linear infinite;
  }
  @keyframes drift {
    0%   { left: -4%;  opacity: 0; transform: translateY(0); }
    12%  { opacity: var(--mote-op); }
    88%  { opacity: var(--mote-op); }
    100% { left: 104%; opacity: 0; transform: translateY(-38px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wind { display: none; }
    .mote { animation: none; }
  }

  .approach-prompt {
    position: absolute;
    pointer-events: auto; /* re-enable: stage-frame has pointer-events:none */
    /* JS overrides left/top after measuring the visible figure; CSS is fallback */
    right: 10%;
    bottom: 38%;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text);
    background: rgba(10, 8, 22, 0.55);
    border: 2px solid rgba(233, 226, 207, 0.22);
    border-radius: 4px;
    /* Vertical padding bumped from 0.35rem: this is the one control a phone
       visitor must hit first, and it sat well under the 44px touch-target
       floor. Left padding reserves a 1.25ch gutter for the caret (::before
       below), same idiom as .choices button — nothing shifts when it fades in. */
    padding: 0.85rem 0.75rem 0.85rem calc(0.75rem + 1.25ch);
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease,
      translate 0.1s ease;
  }
  /* B6: the one control asking to be interacted with gets a slow idle bob —
     animated on the inner label, not the button. Playwright's click
     actionability requires the CLICKED element's own bounding box to hold
     still across two frames; an infinite animation on .approach-prompt
     itself made every existing click on it time out. The label bobs inside a
     geometrically static button instead — same visual "this moves", no
     conflict with positionPrompt()'s own use of the button's `transform`. */
  .prompt-label {
    display: inline-block;
    animation: prompt-bob 2.4s ease-in-out infinite;
  }
  @keyframes prompt-bob {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -2px; }
  }
  .approach-prompt::before {
    content: '▸' / ''; /* alt-text form: excludes the caret from the accessible name */
    position: absolute;
    left: 0.75rem;
    top: 50%;
    translate: 0 -50%;
    opacity: 0;
    color: var(--btn-hover-text);
  }
  .approach-prompt:hover,
  .approach-prompt:focus-visible {
    color: var(--btn-hover-text);
    border-color: var(--btn-hover-border);
    background: rgba(10, 8, 22, 0.75);
  }
  .approach-prompt:hover::before,
  .approach-prompt:focus-visible::before {
    opacity: 1;
  }
  .approach-prompt:focus-visible {
    outline: 2px solid var(--btn-hover-border);
    outline-offset: 2px;
  }
  .approach-prompt:active {
    translate: 0 1px;
  }
  :root[data-time="day"] .approach-prompt {
    background: rgba(253, 251, 245, 0.65);
    border-color: rgba(37, 48, 56, 0.22);
  }
  :root[data-time="day"] .approach-prompt:hover,
  :root[data-time="day"] .approach-prompt:focus-visible {
    background: rgba(253, 251, 245, 0.88);
  }
  @media (prefers-reduced-motion: reduce) {
    .approach-prompt { transition: none; }
    .prompt-label { animation: none; }
  }

  .fullscreen-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    pointer-events: auto; /* re-enable: stage-frame has pointer-events:none */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text);
    background: rgba(10, 8, 22, 0.55);
    border: 1px solid rgba(233, 226, 207, 0.22);
    border-radius: 999px;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  /* display:flex above is author-origin CSS, outranking the UA stylesheet's
     [hidden]{display:none} regardless of selector specificity — left alone it
     would render the button even while `hidden` is set. Reasserted explicitly
     so JS (or its absence) stays the only thing that can reveal this button. */
  .fullscreen-toggle[hidden] { display: none; }
  .fullscreen-toggle:hover,
  .fullscreen-toggle:focus-visible {
    color: var(--btn-hover-text);
    border-color: var(--btn-hover-border);
    background: rgba(10, 8, 22, 0.75);
  }
  .fullscreen-toggle:focus-visible {
    outline: 2px solid var(--btn-hover-border);
    outline-offset: 2px;
  }
  :root[data-time="day"] .fullscreen-toggle {
    background: rgba(253, 251, 245, 0.65);
    border-color: rgba(37, 48, 56, 0.22);
  }
  :root[data-time="day"] .fullscreen-toggle:hover,
  :root[data-time="day"] .fullscreen-toggle:focus-visible {
    background: rgba(253, 251, 245, 0.88);
  }
  @media (prefers-reduced-motion: reduce) {
    .fullscreen-toggle { transition: none; }
  }
  /* Portrait: the dialogue card runs almost the full frame height, leaving no
     clear bottom-right corner. The one band clear of the toggle, card, and
     figure/approach-prompt in between is just under the toggle, so the
     button moves there for this aspect only; every other variant has room
     to spare at the literal bottom-right and is left alone. */
  @media (max-aspect-ratio: 4/5) {
    .fullscreen-toggle { top: 4rem; bottom: auto; }
  }
  /* Fullscreen is the full-window mode already used elsewhere — scenes crop
     via preserveAspectRatio rather than stretch, so no new scaling strategy is
     needed. Explicit width/height override aspect-ratio (it only fills a
     missing dimension), so no separate aspect-ratio:auto override is needed. */
  .stage-frame:fullscreen {
    max-width: none;
    width: 100vw;
    height: 100vh;
    margin: 0;
    border-radius: 0;
    border: none;
  }

  /* .banner-plane has no static markup — JS-created only, so the no-JS path
     never renders it. vw-based flight path, not scene-relative: a screen-space
     overlay like .fullscreen-toggle, it need not track the SVG's slice crop. */
  .banner-plane {
    position: absolute;
    top: 14%;
    left: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
    /* Always white, not theme-linked — day sky needs the shadow to stay legible. */
    color: #fff;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35));
    animation-name: plane-fly;
    animation-timing-function: linear;
    opacity: 1;
    transition: opacity 400ms ease; /* fade out, not a hard cut */
  }
  .banner-plane.plane-fade-out { opacity: 0; }
  @keyframes plane-fly {
    from { transform: translateX(-18vw); }
    to   { transform: translateX(118vw); }
  }
  .plane-icon { flex: none; }
  .banner-tow { flex: none; width: 26px; height: 2px; background: currentColor; }
  .banner-rect {
    flex: none;
    background: #000;
    color: #fff;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.7rem;
    border-radius: 2px;
    white-space: nowrap;
  }

  /* d30: padded hitbox around the plane icon — pointer-events:auto here only,
     so .banner-plane itself stays pointer-events:none (unchanged for its
     existing "never blocks the approach prompt" test). Sits inside the same
     aria-hidden container as the icon, so it never surfaces in the a11y
     tree — matches how the plane itself is hidden today, nothing extra needed. */
  .plane-hit {
    pointer-events: auto;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
  }
  /* Overrides the base rule above via specificity (.banner-plane.crashing >
     .banner-plane) — no JS toggling of animation-name needed. --dive-y is
     set per-crash in stage.js (distance from click position down to the sea
     line); animation-duration (CRASH_MS) is set inline for the same reason
     the flight's own duration is. */
  .banner-plane.crashing {
    animation-name: plane-crash;
    animation-timing-function: ease-in;
    animation-fill-mode: forwards;
    transform-origin: 50% 50%;
  }
  @keyframes plane-crash {
    /* translate before rotate — rotate() spins the element in the axes left
       by whatever precedes it, so translate must come first or "down" tilts
       off toward whatever direction the rotation happens to be mid-spin. */
    0%   { transform: translate(0, 0) rotate(0deg); }
    12%  { transform: translate(0, 0) rotate(16deg); }
    24%  { transform: translate(0, 0) rotate(-16deg); }
    36%  { transform: translate(0, 0) rotate(12deg); }
    48%  { transform: translate(0, 0) rotate(-10deg); }
    60%  { transform: translate(0, 0) rotate(4deg); }
    100% { transform: translate(-4vw, var(--dive-y, 260px)) rotate(500deg); }
  }
  /* The banner detaches into its own sibling (stage.js reparents the
     existing .banner-rect/.banner-tow nodes) so it falls on a separate,
     gentler arc instead of riding the plane's spiral down. */
  .banner-detached {
    position: absolute;
    display: flex;
    align-items: center;
    pointer-events: none;
    color: #fff;
    animation-name: banner-flutter;
    animation-timing-function: ease-in;
    animation-fill-mode: forwards;
  }
  @keyframes banner-flutter {
    /* translate before rotate — see the plane-crash keyframes' note. */
    0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
    40%  { transform: translateY(calc(var(--dive-y, 260px) * 0.5)) rotate(-12deg); }
    75%  { transform: translateY(calc(var(--dive-y, 260px) * 0.85)) rotate(9deg); }
    100% { transform: translateY(var(--dive-y, 260px)) rotate(-5deg); opacity: 0; }
  }
  /* Splash: reuses the scene's f-wave idiom (Scene.astro/tokens.css) — a
     small var(--wave)-coloured bar — plus a brief expanding ripple. */
  .plane-splash {
    position: absolute;
    pointer-events: none;
  }
  .plane-splash::before {
    content: '';
    position: absolute;
    left: -17px;
    top: -3px;
    width: 34px;
    height: 6px;
    border-radius: 3px;
    background: var(--wave);
    animation: splash-pop 200ms ease-out forwards;
  }
  .plane-splash::after {
    content: '';
    position: absolute;
    left: -8px;
    top: -8px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--wave);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
    animation: splash-ripple 350ms ease-out 150ms forwards;
  }
  @keyframes splash-pop {
    0%   { transform: scaleX(0.2); opacity: 0; }
    40%  { transform: scaleX(1.3); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }
  @keyframes splash-ripple {
    0%   { transform: scale(0.3); opacity: 0.8; }
    100% { transform: scale(2.6); opacity: 0; }
  }
  /* Standard + wide only — the horizontal fly-through reads oddly on the
     narrow tall scene. */
  @media (max-aspect-ratio: 4/5) {
    .banner-plane { display: none; }
  }
  /* Belt-and-braces: JS already gates plane scheduling via reducedMotion()
     (flyPlane()), but the media query covers the setting flipping mid-session,
     same as .wind and .camera above. */
  @media (prefers-reduced-motion: reduce) {
    .banner-plane { display: none; }
  }

  /* .end-dialogue lives inside .card, styled like .choices button.system —
     the shared "system-language" colours, hover/focus and caret live in the
     combined selectors alongside button.system below (d31 Part B, B5's
     "rides along, cheap" note); this block keeps only the standalone box
     model button.system gets for free from `.choices button`. */
  .end-dialogue {
    display: block;
    position: relative;
    width: 100%;
    text-align: left;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--dim);
    background: transparent;
    border: 2px dashed var(--option-border);
    border-radius: 4px;
    /* Left padding reserves a 1.25ch gutter for the caret (::before below),
       same idiom as .choices button — nothing shifts when it fades in. */
    padding: 0.65rem 1.2rem 0.65rem calc(1.2rem + 1.25ch);
    cursor: pointer;
    margin-top: 0.75rem;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .end-dialogue::before {
    content: '▸' / ''; /* alt-text form: excludes the caret from the accessible name */
    position: absolute;
    left: 1.2rem;
    top: 50%;
    translate: 0 -50%;
    opacity: 0;
  }
  .end-dialogue:hover::before,
  .end-dialogue:focus-visible::before {
    opacity: 1;
  }
  /* Same author-origin-vs-UA-stylesheet override as .fullscreen-toggle[hidden] above */
  .end-dialogue[hidden] { display: none; }
  .end-dialogue:focus-visible {
    outline: 2px solid var(--stage);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .end-dialogue { transition: none; }
  }

  /* Dialogue card: an in-scene overlay, not a block below the scene */
  .card {
    position: absolute;
    left: 50%;
    bottom: 3.5%;
    transform: translateX(-50%);
    width: min(600px, 88%);
    max-height: calc(96.5svh - 1rem); /* short viewports: scroll */
    overflow-y: auto;
    pointer-events: auto; /* re-enable: stage-frame has pointer-events:none */
    padding: 1.75rem 2rem 2rem;
    background: var(--card);
    border: 1px solid var(--card-edge);
    border-radius: 18px;
    box-shadow: var(--card-shadow);
    /* Opacity/transform tail on the transition list — 170ms delay + 380ms
       duration lands at 550ms, matching the camera zoom's own 550ms. */
    transition: background 0.4s ease, border-color 0.4s ease,
      opacity 380ms ease 170ms, transform 380ms ease 170ms;
  }
  /* JS-only starting state (added by approach()'s init, re-armed by exit()) —
     never static on .card itself, or the no-JS path would render it invisible. */
  .card.card-entering {
    opacity: 0;
    transform: translateX(-50%) translateY(6px);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .name {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: var(--chip-bg);
    color: var(--chip-text);
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
  }
  .stage {
    font-size: 0.92rem;
    font-style: italic;
    color: var(--stage);
    margin: 0 0 0.75rem;
  }
  .speech, .speech-stream {
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
    min-height: 3.2em;
  }
  .speech {
    transition: opacity 0.25s ease;
  }
  /* Visually-hidden while streaming, never display:none — clip-path keeps
     #speech (the live region) in the a11y tree so its already-complete text
     stays announced, while the sibling .speech-stream carries the visible
     typewriter reveal. */
  .speech.speech-clip {
    position: absolute;
    clip-path: inset(50%);
  }
  .speech-stream .pending {
    visibility: hidden;
  }
  /* Dimmed, not disabled — every activation is swallowed by the card's own
     skip listener while streaming, so this is the disabled-control carve-out,
     not a contrast regression. */
  .card.is-streaming .choices {
    opacity: 0.55;
  }
  .choices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .choices button {
    display: block;
    position: relative;
    width: 100%;
    text-align: left;
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--option);
    background: transparent;
    border: 2px solid var(--option-border);
    border-radius: 4px;
    /* Left padding reserves a 1.25ch gutter for the caret (::before below),
       B1 (d31 Part B) — nothing shifts when it fades in on hover/focus. */
    padding: 0.65rem 1.2rem 0.65rem calc(1.2rem + 1.25ch);
    cursor: pointer;
    transition: color 0.12s ease, border-color 0.12s ease, background 0.12s ease,
      transform 0.12s ease, translate 0.12s ease;
  }
  .choices button::before {
    content: '▸' / ''; /* alt-text form: excludes the caret from the accessible name */
    position: absolute;
    left: 1.2rem;
    top: 50%;
    translate: 0 -50%;
    opacity: 0;
    color: var(--btn-hover-text);
  }
  .choices button:hover,
  .choices button:focus-visible {
    color: var(--btn-hover-text);
    border-color: var(--btn-hover-border);
    background: var(--btn-hover-bg);
    transform: translateY(-1px);
  }
  .choices button:hover::before,
  .choices button:focus-visible::before {
    opacity: 1;
  }
  .choices button:focus-visible {
    outline: 2px solid var(--btn-hover-border);
    outline-offset: 2px;
  }
  /* B2: choices already lift 1px on hover via `transform`; :active resets
     that (still-matching :hover would otherwise stack with it) and applies
     its own 1px via the independent `translate` property, so hover -> press
     is a real 2px travel rather than the two partially cancelling out. */
  .choices button:active {
    transform: none;
    translate: 0 1px;
  }
  .choices button.system {
    border-style: dashed;
    color: var(--dim);
    font-size: 0.82rem;
  }
  .choices button.system::before,
  .end-dialogue::before {
    color: var(--stage);
  }
  /* B5: system options and End dialogue take the same caret (one selection
     language) but get neither the hover fill nor the press lift — border and
     text highlight only. */
  .choices button.system:hover,
  .choices button.system:focus-visible,
  .end-dialogue:hover,
  .end-dialogue:focus-visible {
    color: var(--stage);
    border-color: var(--stage);
    background: transparent;
    transform: none;
  }
  /* transform:none here too, not just translate:none — the build's minifier
     folds .choices button:active's `transform:none; translate:0 1px` into a
     single `transform:translateY(1px)`, so translate:none alone stops
     neutralising the press lift once that folding happens. */
  .choices button.system:active {
    transform: none;
    translate: none;
  }
  .noscript-note {
