---
// ThemeToggle.astro — turns the world's sky over: night (default) or day.
// HUD chip, top right. Base.astro's inline head script applies the stored
// theme before first paint; this only syncs the label and handles clicks.
---
<button class="toggle" id="toggle" aria-label="Switch to day mode"><span class="toggle-icon">☼</span> day</button>

<script>
  const toggle = document.getElementById('toggle') as HTMLButtonElement;
  const icon = toggle.querySelector('.toggle-icon') as HTMLSpanElement;
  const label = icon.nextSibling as Text;

  // Mutates the existing icon span/text node in place rather than rebuilding
  // them, so the span keeps Astro's scoped-style hash.
  function syncLabel(isDay: boolean) {
    icon.textContent = isDay ? '☽' : '☼';
    label.textContent = isDay ? ' night' : ' day';
    toggle.setAttribute('aria-label', isDay ? 'Switch to night mode' : 'Switch to day mode');
  }
  syncLabel(document.documentElement.dataset.time === 'day');

  // One glyph flip per click; the class is removed on animationend, with a
  // timer fallback for when no animation plays (reduced motion). The fallback
  // must comfortably exceed the 220ms flip so it never races animationend.
  const FLIP_FALLBACK_MS = 2000;
  let flipTimer: ReturnType<typeof setTimeout>;
  function endFlip() {
    toggle.classList.remove('flipping');
    clearTimeout(flipTimer);
  }
  toggle.addEventListener('animationend', (e) => {
    if (e.animationName === 'toggle-flip') endFlip();
  });
  toggle.addEventListener('click', () => {
    const isDay = document.documentElement.dataset.time === 'day';
    const next  = isDay ? 'night' : 'day';
    document.documentElement.dataset.time = next;
    localStorage.setItem('time', next);
    syncLabel(!isDay);
    endFlip();
    void toggle.offsetWidth; // restart the animation on a rapid second click
    toggle.classList.add('flipping');
    flipTimer = setTimeout(endFlip, FLIP_FALLBACK_MS);
  });
</script>

<style>
  .toggle {
    position: absolute;
    top: 1rem;
    right: 1rem;
    /* .stage-frame is full-bleed and later in the DOM; z-index lifts the
       toggle above it. */
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--prompt-ink);
    text-shadow: 0 1px 3px rgba(7, 6, 14, 1), 0 0 12px rgba(7, 6, 14, 0.9);
    background: rgba(6, 10, 18, 0.55);
    border: 1px solid var(--holo-dim);
    border-radius: 3px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: color 0.12s ease, border-color 0.12s ease, translate 0.1s ease;
  }
  .toggle:hover, .toggle:focus-visible {
    color: var(--gold-bright);
    border-color: var(--gold-bright);
  }
  .toggle:focus-visible {
    outline: 1px solid var(--holo);
    outline-offset: 3px;
  }
  .toggle:active {
    translate: 0 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle { transition: none; }
  }
  .toggle-icon {
    display: inline-block;
    font-size: 1.1em;
    color: var(--gold-bright);
  }
  .toggle.flipping .toggle-icon {
    animation: toggle-flip 220ms ease;
  }
  @keyframes toggle-flip {
    from { transform: rotateY(0deg); }
    to   { transform: rotateY(180deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle.flipping .toggle-icon { animation: none; }
  }
</style>
