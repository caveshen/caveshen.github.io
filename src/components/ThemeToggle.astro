<button class="toggle" id="toggle" aria-label="Switch to day mode"><span class="toggle-icon">☼</span> day</button>

<script>
  const toggle = document.getElementById('toggle') as HTMLButtonElement;
  const icon = toggle.querySelector('.toggle-icon') as HTMLSpanElement;
  const label = icon.nextSibling as Text;

  // Sync button label to the theme already applied by Base.astro's inline script.
  // Mutates the existing icon span/text node in place rather than rebuilding
  // them, so the span keeps Astro's scoped-style hash (see the style block below).
  function syncLabel(isDay: boolean) {
    icon.textContent = isDay ? '☽' : '☼';
    label.textContent = isDay ? ' night' : ' day';
    toggle.setAttribute('aria-label', isDay ? 'Switch to night mode' : 'Switch to day mode');
  }
  syncLabel(document.documentElement.dataset.time === 'day');

  // B7 (d31 Part B): the diegetic touch — turning the sky over. Pure CSS
  // keyframe (gated by prefers-reduced-motion in the stylesheet below); this
  // just brackets it with a class so it replays every click. The timer is
  // held and cleared on each click so a rapid second click's animation gets
  // its own full 220ms instead of being cut short by the first click's timer.
  let flipTimer: ReturnType<typeof setTimeout>;
  toggle.addEventListener('click', () => {
    const isDay = document.documentElement.dataset.time === 'day';
    const next  = isDay ? 'night' : 'day';
    document.documentElement.dataset.time = next;
    localStorage.setItem('time', next);
    syncLabel(!isDay);
    // animationstart failed to fire once on iphone-15pro in CI (root cause
    // unconfirmed — plausibly the 220ms cleanup timeout below cancelling the
    // animation before a stalled worker's first frame). remove/reflow/add is
    // the canonical restart idiom and is defensive here regardless of cause;
    // it also fixes a real bug the old add-only code had on rapid double
    // clicks — inside the 220ms window 'flipping' is still present, so a
    // bare classList.add() is a no-op and never restarts the animation.
    toggle.classList.remove('flipping');
    void toggle.offsetWidth;
    toggle.classList.add('flipping');
    clearTimeout(flipTimer);
    flipTimer = setTimeout(() => toggle.classList.remove('flipping'), 220);
  });
  // ponytail: test hook only. Set synchronously right after the click
  // listener above is registered, so e2e/button-feel.spec.js can wait for
  // this module script to have actually run (deferred module scripts race
  // page.goto()'s 'load' resolution on a slow CI host) before it dispatches
  // a click and expects the flip to play.
  toggle.dataset.flipReady = '';
</script>

<style>
  .toggle {
    position: absolute;
    top: 1rem;
    right: 1rem;
    /* .stage-frame is full-bleed and later in the DOM, so it would otherwise
       paint over this earlier sibling; z-index lifts the toggle above it
       (see the matching note on .page-foot). */
    z-index: 1;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--text);
    /* B7 (d31 Part B): join the HUD — same translucent glass chip as
       .page-foot/.fullscreen-toggle (Stage.astro) instead of a solid --card,
       so the three corner elements read as one HUD language. Also B3's box:
       4px-radius rectangle, 2px border, replacing the pill. */
    background: rgba(10, 8, 22, 0.55);
    border: 2px solid rgba(233, 226, 207, 0.22);
    border-radius: 4px;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: color 0.12s ease, border-color 0.12s ease, background 0.4s ease,
      translate 0.1s ease;
  }
  .toggle:hover, .toggle:focus-visible {
    color: var(--btn-hover-text);
    border-color: var(--btn-hover-border);
    background: rgba(10, 8, 22, 0.75);
  }
  .toggle:focus-visible {
    outline: 2px solid var(--btn-hover-border);
    outline-offset: 2px;
  }
  .toggle:active {
    translate: 0 1px;
  }
  :root[data-time="day"] .toggle {
    background: rgba(253, 251, 245, 0.65);
    border-color: rgba(37, 48, 56, 0.22);
  }
  :root[data-time="day"] .toggle:hover,
  :root[data-time="day"] .toggle:focus-visible {
    background: rgba(253, 251, 245, 0.88);
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle { transition: none; }
  }
  /* B7's diegetic touch: one 180deg rotateY flip on the glyph as the theme
     crossfades — turning the sky over. rotateY, not translate: nothing else
     drives this element's transform, so there's no trap to dodge here. */
  .toggle-icon {
    display: inline-block;
  }
  .toggle.flipping .toggle-icon {
    animation: toggle-flip 220ms ease;
  }
  @keyframes toggle-flip {
    from { transform: rotateY(0deg); }
    to   { transform: rotateY(180deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle.flipping .toggle-icon { animation: none; }
  }
</style>
