---
// ThresholdCover.astro — the title screen. Caveshen's own night photograph of
// Cape Town, toned into the night tokens, with a main-menu column on the left:
// name, role, then the menu. Ships visible by default (the static build has no
// server to branch on); index.astro's inline head script sets
// [data-cover="skip"] on <html> before first paint when the session flag is
// already set, and the reduced-motion media query below drops the cover
// unconditionally. The noscript rule is the third gate, for JS disabled.
//
// New Game plays the un-develop: the menu fades, the photo drains, and
// #scene-root's pre-armed gold wireframe (tokens.css) blooms in by depth
// underneath. All timing lives in tokens.css's --undevelop-* block.
//
// Main menu: a quiet button on the arrived scene brings the cover back
// (session flag cleared, scene re-armed) so New Game can be replayed. The
// cover element is hidden, not removed, once dismissed.
---
<div class="threshold-cover" id="threshold-cover">
  <!-- Defs-only: 0×0 and clipped, never display:none (some engines skip a
       filter whose <svg> ancestor is display:none). -->
  <svg class="cover-filter-defs" aria-hidden="true" focusable="false">
    <defs>
      <filter id="threshold-duotone" color-interpolation-filters="sRGB">
        <!-- Light unsharp mask ahead of the tone map: the table transfer
             posterises luminance into steps, so any softness in the source
             reads as a blurred edge once mapped. -->
        <feConvolveMatrix order="3" preserveAlpha="true" edgeMode="duplicate"
          kernelMatrix="0 -0.5 0 -0.5 3 -0.5 0 -0.5 0" />
        <feColorMatrix type="saturate" values="0" />
        <!--
          Four-stop tone map, dark to light: --sky, --sky-horizon, a mid holo
          blue, --celestial. Shadows go navy, the sky goes blue, and only the
          brightest values (the horizon glow, the city lights) reach gold.
          tableValues cannot read var(), so these are literals from tokens.css,
          each channel/255 to 4dp; src/tests/threshold.test.js checks the two
          end stops against the tokens.
        -->
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.0392 0.1098 0.2902 1" />
          <feFuncG type="table" tableValues="0.0784 0.2078 0.5255 0.7686" />
          <feFuncB type="table" tableValues="0.1569 0.3294 0.7412 0.4196" />
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>

  <picture class="cover-photo-wrap">
    <source
      type="image/avif"
      srcset="/threshold/night-640.avif 640w, /threshold/night-1024.avif 1024w,
              /threshold/night-1536.avif 1536w, /threshold/night-2048.avif 2048w"
      sizes="100vw"
    />
    <img
      class="cover-photo"
      src="/threshold/night-2048.jpg"
      srcset="/threshold/night-640.jpg 640w, /threshold/night-1024.jpg 1024w,
              /threshold/night-1536.jpg 1536w, /threshold/night-2048.jpg 2048w"
      sizes="100vw"
      width="2048" height="1153"
      alt=""
      fetchpriority="high"
      decoding="sync"
    />
  </picture>
  <div class="cover-vignette" aria-hidden="true"></div>

  <!-- HUD frame: four corner brackets and a single scan sweep on load. -->
  <div class="cover-frame" aria-hidden="true">
    <span class="bracket tl"></span><span class="bracket tr"></span>
    <span class="bracket bl"></span><span class="bracket br"></span>
    <span class="scanline"></span>
  </div>

  <div class="cover-content">
    <h1 class="cover-name">Caveshen Rajman</h1>
    <p class="cover-role">Engineering Manager, Cape Town</p>
    <p class="cover-tagline">Problem solver, coffee enjoyer, 10x human</p>
    <nav class="cover-menu" aria-label="Main menu">
      <button type="button" id="cover-new-game" class="cover-btn cover-btn-primary">
        New game <kbd class="cover-hotkey" aria-hidden="true">1</kbd>
      </button>
      <a href="/sheet" id="cover-sheet" class="cover-btn cover-btn-secondary">
        Character sheet <kbd class="cover-hotkey" aria-hidden="true">2</kbd>
      </a>
      <a href="/cv.pdf" id="cover-cv" class="cover-btn cover-btn-secondary">
        Download CV <kbd class="cover-hotkey" aria-hidden="true">3</kbd>
      </a>
      <a href="https://www.linkedin.com/in/caveshen" id="cover-linkedin" class="cover-btn cover-btn-secondary">
        LinkedIn <kbd class="cover-hotkey" aria-hidden="true">4</kbd>
      </a>
    </nav>
  </div>

  <!-- Readout: where the photograph was taken. Real coordinates, the system's voice. -->
  <p class="cover-telemetry" aria-hidden="true">
    <span>33.9249° S, 18.4241° E</span>
    <span>Cape Town, South Africa</span>
  </p>
</div>

<!-- Ships hidden; JS unhides it once it knows the cover isn't showing. -->
<button type="button" id="return-to-menu" class="return-to-menu" hidden>
  <kbd aria-hidden="true">Esc</kbd> Main menu
</button>

<!-- No-JS: the scene stands untouched — the cover, which needs JS to ever
     leave, must not be there to block it. -->
<noscript>
  <style>.threshold-cover { display: none !important; }</style>
</noscript>

<script>
  const FLAG = 'thresholdDismissed';
  const cover = document.getElementById('threshold-cover')!;
  const sceneRoot = document.getElementById('scene-root');
  const returnBtn = document.getElementById('return-to-menu')!;
  // Moved to the end of <body> so it lands last in tab order, after the scene.
  document.body.appendChild(returnBtn);
  const reducedMotionQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const alreadyDismissed = document.documentElement.dataset.cover === 'skip';

  // Fills at zero, gold strokes on (tokens.css) — the scene stands as
  // line-art under the opaque cover, ready for New Game to bloom it.
  function armScene() {
    if (!sceneRoot) return;
    sceneRoot.setAttribute('inert', '');
    sceneRoot.classList.remove('blooming');
    sceneRoot.classList.add('pre-armed');
  }

  // The un-develop: menu fades, photo drains (this file's CSS), and the
  // pre-armed scene blooms in by depth (tokens.css).
  function dismiss() {
    sessionStorage.setItem(FLAG, '1');
    document.removeEventListener('keydown', onKey);
    if (sceneRoot) sceneRoot.removeAttribute('inert');

    if (reducedMotionQuery.matches) {
      if (sceneRoot) sceneRoot.classList.remove('pre-armed', 'blooming');
      cover.hidden = true;
      cover.classList.remove('cover-undeveloping', 'cover-forced-visible', 'cover-returning');
      returnBtn.hidden = false;
      document.dispatchEvent(new CustomEvent('scene:enter'));
      return;
    }

    cover.classList.add('cover-undeveloping');
    document.dispatchEvent(new CustomEvent('scene:enter'));
    if (sceneRoot) {
      sceneRoot.classList.remove('pre-armed');
      sceneRoot.classList.add('blooming');
    }
    cover.addEventListener('transitionend', function onFaded(e) {
      if (e.target !== cover || e.propertyName !== 'opacity') return;
      cover.removeEventListener('transitionend', onFaded);
      cover.hidden = true;
      cover.classList.remove('cover-undeveloping', 'cover-forced-visible');
      returnBtn.hidden = false;
      if (document.activeElement === document.body) {
        sceneRoot?.querySelector('button, a[href]')?.focus();
      }
    });
  }

  // Both routes to /sheet (the link click and the "2" hotkey) set the session
  // flag once, here, before leaving the page.
  function visitSheet() {
    sessionStorage.setItem(FLAG, '1');
    window.location.href = '/sheet';
  }

  function onKey(e: KeyboardEvent) {
    if (e.key === '1') { e.preventDefault(); dismiss(); }
    else if (e.key === '2') { e.preventDefault(); visitSheet(); }
    else if (e.key === '3') { e.preventDefault(); window.location.href = '/cv.pdf'; }
    else if (e.key === '4') { e.preventDefault(); window.location.href = 'https://www.linkedin.com/in/caveshen'; }
  }

  document.getElementById('cover-new-game')!.addEventListener('click', dismiss);
  document.getElementById('cover-sheet')!.addEventListener('click', (e: MouseEvent) => {
    e.preventDefault();
    visitSheet();
  });

  if (!reducedMotionQuery.matches && !alreadyDismissed) {
    armScene();
    document.addEventListener('keydown', onKey);
  } else {
    returnBtn.hidden = false;
  }

  function returnToMenu() {
    sessionStorage.removeItem(FLAG);
    delete document.documentElement.dataset.cover;
    returnBtn.hidden = true;
    armScene();
    document.addEventListener('keydown', onKey);

    cover.hidden = false;
    cover.classList.add('cover-forced-visible');
    if (reducedMotionQuery.matches) return;

    cover.classList.remove('cover-returning');
    void cover.offsetWidth; // force reflow so the class change below transitions rather than no-ops
    cover.classList.add('cover-returning');
    requestAnimationFrame(() => cover.classList.remove('cover-returning'));
  }
  returnBtn.addEventListener('click', returnToMenu);
  // Escape brings the menu back only when no dialogue is open (stage.js owns
  // Escape while one is). The dialogue leaves .card unhidden while open.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || returnBtn.hidden) return;
    if (document.querySelector('.card:not([hidden])')) return;
    returnToMenu();
  });
</script>

<style>
  .threshold-cover {
    position: fixed;
    inset: 0;
    z-index: 50;
    overflow: hidden;
    display: flex;
    background: var(--sky);
  }
  @media (prefers-reduced-motion: reduce) {
    .threshold-cover { display: none; }
  }

  .threshold-cover.cover-undeveloping {
    pointer-events: none;
    transition: opacity var(--undevelop-photo-drain) ease;
    opacity: 0;
  }
  .threshold-cover.cover-undeveloping .cover-content,
  .threshold-cover.cover-undeveloping .cover-frame,
  .threshold-cover.cover-undeveloping .cover-telemetry {
    transition: opacity var(--undevelop-title-fade) ease;
    opacity: 0;
  }
  :root[data-cover="skip"] .threshold-cover { display: none; }
  .threshold-cover[hidden] { display: none; }
  .threshold-cover.cover-forced-visible { display: flex !important; }
  .threshold-cover.cover-returning {
    transition: opacity 0.3s ease;
    opacity: 0;
  }

  .cover-filter-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  .cover-photo-wrap { position: absolute; inset: 0; overflow: hidden; }
  .cover-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Top-anchored crop and zoom: keeps the ridge low in frame, clear of the
       menu column, at both the wide desktop crop and the tall mobile one. */
    object-position: 60% 0%;
    transform-origin: 60% 0%;
    transform: scale(1.18);
    filter: url(#threshold-duotone);
  }

  /* The menu column reads over a darkened left third; the right stays open
     so the mountain and the city lights carry the picture. */
  .cover-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 10, 18, 0.82) 0%, rgba(6, 10, 18, 0.55) 34%, rgba(6, 10, 18, 0) 62%),
      linear-gradient(180deg, rgba(6, 10, 18, 0.35) 0%, rgba(6, 10, 18, 0) 30%, rgba(6, 10, 18, 0) 70%, rgba(6, 10, 18, 0.7) 100%);
    pointer-events: none;
  }

  /* ── HUD frame ── */
  .cover-frame { position: absolute; inset: 0; pointer-events: none; }
  .bracket {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 1px solid var(--holo);
    opacity: 0.6;
  }
  .bracket.tl { top: 1.25rem; left: 1.25rem; border-right: 0; border-bottom: 0; }
  .bracket.tr { top: 1.25rem; right: 1.25rem; border-left: 0; border-bottom: 0; }
  .bracket.bl { bottom: 1.25rem; left: 1.25rem; border-right: 0; border-top: 0; }
  .bracket.br { bottom: 1.25rem; right: 1.25rem; border-left: 0; border-top: 0; }
  .scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--holo) 40%, var(--holo) 60%, transparent);
    opacity: 0;
    animation: scan-sweep 1.4s cubic-bezier(0.4, 0, 0.6, 1) 0.1s 1 both;
  }
  @keyframes scan-sweep {
    0%   { transform: translateY(0); opacity: 0; }
    8%   { opacity: 0.55; }
    92%  { opacity: 0.55; }
    100% { transform: translateY(100vh); opacity: 0; }
  }

  /* ── Title block and menu: a left column, the way a main menu sits ── */
  .cover-content {
    position: relative;
    z-index: 1;
    align-self: center;
    margin-left: clamp(1.5rem, 8vw, 9rem);
    margin-right: 1.5rem;
    max-width: 34rem;
    padding: 1rem 0;
  }

  /* Text-over-photo AA (src/tests/threshold.test.js): a dark anchor
     text-shadow carries the contrast duty, not a chip. */
  .cover-name, .cover-tagline, .cover-btn-secondary {
    color: var(--prompt-ink);
    text-shadow: 0 1px 3px rgba(7, 6, 14, 1), 0 0 12px rgba(7, 6, 14, 1),
                 0 0 20px rgba(7, 6, 14, 0.7);
  }

  .cover-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    letter-spacing: 0.04em;
    line-height: 1.05;
    margin: 0;
  }
  .cover-role {
    font-family: var(--hud);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--holo);
    text-shadow: 0 1px 3px rgba(7, 6, 14, 1), 0 0 12px rgba(7, 6, 14, 0.9);
    margin: 0.7rem 0 0;
  }
  .cover-tagline {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    margin: 0.5rem 0 0;
  }

  .cover-menu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    margin-top: 2.2rem;
    padding-top: 1.6rem;
    position: relative;
  }
  /* A short gold rule separates the title from the menu. */
  .cover-menu::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4rem;
    height: 1px;
    background: var(--gold);
  }
  .cover-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 44px;
    padding: 0.35rem 1rem 0.35rem 1.1rem;
    margin-left: -1.1rem;
    font-family: var(--hud);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    border-left: 3px solid transparent;
    transition: color var(--t-micro), border-color var(--t-micro), translate var(--t-micro);
  }
  .cover-btn-primary {
    color: var(--gold-bright);
    background: var(--btn-hover-bg);
    border-left-color: var(--gold);
    text-shadow: 0 1px 3px rgba(7, 6, 14, 1), 0 0 12px rgba(7, 6, 14, 0.9);
  }
  .cover-btn:hover, .cover-btn:focus-visible {
    color: var(--gold-bright);
    border-left-color: var(--gold-bright);
    translate: 4px 0;
  }
  .cover-btn:focus-visible {
    outline: 1px solid var(--holo);
    outline-offset: 3px;
  }
  .cover-btn:disabled {
    filter: blur(2px);
    cursor: not-allowed;
  }
  .cover-hotkey {
    font-family: var(--hud);
    font-size: 0.7em;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    min-width: 1.5em;
    padding: 0.15em 0.35em;
    text-align: center;
    color: var(--holo);
    border: 1px solid var(--holo-dim);
    border-radius: 3px;
    text-shadow: none;
  }

  /* Menu rows arrive one after another: the one page-load sequence. */
  .cover-content > * { animation: hud-in 420ms ease-out both; }
  .cover-name    { animation-delay: 120ms; }
  .cover-role    { animation-delay: 220ms; }
  .cover-tagline { animation-delay: 300ms; }
  .cover-menu    { animation-delay: 380ms; }
  @keyframes hud-in {
    from { opacity: 0; transform: translateX(-10px); }
    to   { opacity: 1; transform: none; }
  }

  .cover-telemetry {
    position: absolute;
    left: 2.25rem;
    right: 2.25rem;
    bottom: 1.6rem;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--hud);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--holo);
    opacity: 0.8;
    text-shadow: 0 1px 2px rgba(7, 6, 14, 1);
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .cover-telemetry { flex-direction: column; gap: 0.2rem; font-size: 0.7rem; }
    .cover-content { margin-left: 1.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-btn { transition: none; }
    .scanline, .cover-content > * { animation: none; }
  }

  /* Main menu, on the arrived scene: HUD text at the bottom right, beside
     the fullscreen toggle (Stage.astro). White ink and a dark anchor shadow
     so it reads over both themes. */
  .return-to-menu {
    position: fixed;
    right: 4.5rem;
    bottom: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--prompt-ink);
    text-shadow: 0 1px 3px rgba(7, 6, 14, 1), 0 0 12px rgba(7, 6, 14, 1),
                 0 0 20px rgba(7, 6, 14, 0.7);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--t-micro);
  }
  .return-to-menu[hidden] { display: none; }
  .return-to-menu kbd {
    font-family: var(--hud);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.1em 0.4em;
    color: var(--holo);
    border: 1px solid var(--holo-dim);
    border-radius: 3px;
    text-shadow: none;
    background: rgba(6, 10, 18, 0.6);
  }
  .return-to-menu:hover, .return-to-menu:focus-visible {
    color: var(--gold-bright);
  }
  .return-to-menu:focus-visible {
    outline: 1px solid var(--holo);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .return-to-menu { transition: none; }
  }
</style>
