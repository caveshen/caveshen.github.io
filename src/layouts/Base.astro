---
import '../styles/tokens.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title = "Caveshen Rajman",
  description = "PLACEHOLDER — Caveshen Rajman's portfolio.",
  ogImage = "/og-image.png",
  bodyClass = "",
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.url.toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <!-- the ico also carries a 16px entry; declared 32x32 so browsers take the PNG above for 16px -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <!-- Inline: set data-time before first paint to avoid flash -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("time");
        if (t === "day") document.documentElement.dataset.time = "day";
        // Night is the default — no attribute needed
      })();
    </script>
    <!-- Page-specific head injections (preloads, etc.) -->
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--serif);
    transition: var(--theme-transition);
    min-height: 100vh;
    /* Without this, .stage-frame's margin collapses through body (its first
       in-flow child — the toggle button is absolutely positioned), pushing
       body 1rem below the viewport and causing overflow unrelated to content.
       flow-root gives body its own block-formatting context to contain it. */
    display: flow-root;
  }
</style>
