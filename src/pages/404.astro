---
// 404.astro — the interactive 404 (PRD d1, was §30 D-4). Same interview, in-world:
// the visitor opened a door that isn't in the script. NotFound.astro carries
// the dialogue card (its own tree, dialogue-404.json); this page supplies
// the backdrop — 1:1 with the landing's scene, hooded figure instead of the
// Badger (PRD d17, was §27 remainder — supersedes d1 ANSWERED 2's
// "scenery only": see d17 for the ruling).
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Scene from '../components/Scene.astro';
import HoodedFigure from '../components/HoodedFigure.astro';
import NotFound from '../components/NotFound.astro';

// PRD d17: `/404` owns the hooded figure, and only the hooded figure — no
// selection mechanism, the route is the selector. Same three scene variants
// as `/`, rendered from the shared Scene.astro (PRD d12).
const CHARACTERS = [HoodedFigure];
const CHARACTER_LABEL = 'a hooded figure on the promenade';
---
<Base
  title="404 — Caveshen Rajman"
  description="PLACEHOLDER — Page not found. Caveshen Rajman's portfolio."
  noindex
>
  <ThemeToggle />

  <div class="notfound-stage">
    <!-- PRD d17: scene markup lives once in Scene.astro (PRD d12); 1:1 with
         the landing's three variants. No approach step, no camera zoom here
         (d1 ANSWERED 3 stands) — the figure is scenery that happens to be a
         person, not an interactive NPC. -->
    <Scene variant="standard" characters={CHARACTERS} characterLabel={CHARACTER_LABEL} />
    <Scene variant="wide" characters={CHARACTERS} characterLabel={CHARACTER_LABEL} />
    <Scene variant="tall" characters={CHARACTERS} characterLabel={CHARACTER_LABEL} />
  </div>

  <NotFound />
</Base>

<style is:global>
  .notfound-stage {
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: var(--sky);
    transition: background 0.4s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .notfound-stage { transition: none; }
  }
</style>
