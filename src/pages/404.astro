---
// 404.astro — the interactive 404: same interview, in-world — a door that
// isn't in the script. The hooded figure is approached exactly as the
// Badger is on `/`.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Stage from '../components/Stage.astro';
import HoodedFigure from '../components/HoodedFigure.astro';
import tree from '../data/dialogue-404.json';

const CHARACTER = HoodedFigure;
const CHARACTER_LABEL = 'a hooded figure on the promenade';

---
<Base
  title="404 — Caveshen Rajman"
  description="Page not found. Caveshen Rajman's portfolio."
  noindex
>
  <ThemeToggle />

  <Stage tree={tree} character={CHARACTER} characterLabel={CHARACTER_LABEL}
    speakerName="A hooded figure" promptLabel="Approach the figure"
    areaName="A door not in the script" areaSub="Cape Town">
    <noscript>
      <p class="noscript-note">
        <a href="/">Back to the promenade</a>
      </p>
    </noscript>
  </Stage>
</Base>

<script>
  import { initStage } from '../scripts/stage.js';
  import tree from '../data/dialogue-404.json';

  initStage(tree);
</script>
