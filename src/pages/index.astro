---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Stage from '../components/Stage.astro';
import Badger from '../components/Badger.astro';
import tree from '../data/dialogue.json';

const CHARACTER = Badger;
const CHARACTER_LABEL = 'the Badger';
---
<Base
  title="The Interview — Caveshen Rajman"
  description="PLACEHOLDER — Caveshen Rajman's interactive portfolio. An adventure-game-styled CV for games industry and tech contacts."
>
  <!-- Toggle: first in DOM so it's first in tab order -->
  <ThemeToggle />

  <!-- PRD d25: frame, camera, approach prompt and dialogue card all live in
       Stage.astro now; tree/character/characterLabel/promptLabel are the
       four values that vary by route — the noscript note below is the one
       genuine markup difference, so it's a slot rather than a fifth prop. -->
  <Stage tree={tree} character={CHARACTER} characterLabel={CHARACTER_LABEL}
    promptLabel="Approach the badger">
    <noscript>
      <p class="noscript-note">
        <a href="/sheet">Open the character sheet &rarr;</a>
      </p>
    </noscript>
  </Stage>
</Base>

<script>
  // PRD d25: the whole approach-interaction script now lives in stage.js —
  // everything here was DOM lookups and behaviour with no route-bound logic
  // except this tree import (see PRD d25's "already generic" note).
  import { initStage } from '../scripts/stage.js';
  import tree from '../data/dialogue.json';

  initStage(tree);
</script>
