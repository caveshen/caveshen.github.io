---
// og.astro — the social-card source: the title screen at 1200×630, shot by
// tools/render-og.js. Not a visited page.
import Base from '../layouts/Base.astro';
import ThresholdCover from '../components/ThresholdCover.astro';
---
<Base
  title="Caveshen Rajman"
  description="The social-card composition source, not a visited page."
  noindex
  theme="night"
>
  <div class="og-frame">
    <ThresholdCover />
  </div>
</Base>

<style>
  .og-frame {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
</style>
