---
// sheet.astro — the character record: the CV as a game's character menu.
// Always the night register (menus have no time of day). Tabs are in-page
// anchors, so the whole record reads top to bottom without JavaScript.
import Base from '../layouts/Base.astro';

// Attributes: score out of 20, the way a tabletop sheet reads. Illustrative;
// Caveshen tunes the numbers.
const ATTRIBUTES = [
  { name: 'People',    score: 17 },
  { name: 'Tech',      score: 16 },
  { name: 'Delivery',  score: 16 },
  { name: 'Strategy',  score: 15 },
  { name: 'Product',   score: 14 },
  { name: 'Narrative', score: 13 },
];
const mod = (score: number) => Math.floor((score - 10) / 2);
// Gauge: a 270° arc on r=26; the dash length is the lit fraction of that arc.
const GAUGE_R = 26;
const GAUGE_ARC = 2 * Math.PI * GAUGE_R * 0.75;

// Skill tree: five schools, each a column of nodes, top to bottom in the order
// they were learned. rank 3 = mastered, 2 = proficient, 1 = learning.
const SCHOOLS: Array<{ name: string; nodes: Array<[string, number]> }> = [
  { name: 'Engineering',        nodes: [['.NET and C#', 3], ['SQL', 3], ['JavaScript', 3], ['Spring', 2]] },
  { name: 'Frameworks',         nodes: [['Vue', 2], ['React', 2], ['Angular', 2], ['GraphQL', 2]] },
  { name: 'Cloud and tooling',  nodes: [['Azure', 3], ['Azure DevOps', 3], ['AWS', 2], ['Power BI', 2]] },
  { name: 'Quality',            nodes: [['NUnit and XUnit', 3], ['Selenium', 3], ['Cypress', 2], ['WebDriverIO', 2], ['K6', 2]] },
  { name: 'Leadership',         nodes: [['Mentoring', 3], ['Team building', 3], ['Stakeholders', 3], ['Change management', 2], ['Strategy', 2]] },
];
const COL_W = 200, ROW_H = 74, TOP = 64, HEX_R = 19;
const hexPoints = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = Math.PI / 3 * i + Math.PI / 6;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const treeHeight = TOP + ROW_H * Math.max(...SCHOOLS.map((s) => s.nodes.length)) - 10;
const RANK = ['', 'learning', 'proficient', 'mastered'];
---
<Base
  title="Character sheet — Caveshen Rajman"
  description="Caveshen Rajman's character record: Engineering Manager, level 11. Attributes, skill tree, quest log and codex, with the plain CV to download."
  theme="night"
>
  <script is:inline>
    /* Sets arrived-by-morph on <html> before first paint when a cross-document
       view transition is active — fires before the page renders. */
    window.addEventListener('pagereveal', function(e) {
      window.__vtFinished = e.viewTransition ? e.viewTransition.finished : null;
      if (e.viewTransition) {
        document.documentElement.classList.add('arrived-by-morph');
      }
    });
  </script>

  <header class="menu-bar">
    <a href="/" class="back-link"><kbd aria-hidden="true">Esc</kbd> Back to the promenade</a>
    <nav class="menu-tabs" aria-label="Sections">
      <a href="#character">Character</a>
      <a href="#abilities">Abilities</a>
      <a href="#quests">Quest log</a>
      <a href="#codex">Codex</a>
    </nav>
    <a href="/cv.pdf" class="download-btn">Download CV <span class="download-note">PDF, plain format</span></a>
  </header>

  <main class="record">

    <section class="character" id="character" aria-labelledby="character-name">
      <div class="portrait-frame">
        <img class="head-portrait" src="/sheet-portrait.png" alt="Caveshen Rajman" width="128" height="128" />
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
        <span class="level-badge"><span class="level-word">Level</span>11</span>
      </div>

      <div class="identity">
        <h1 id="character-name">Caveshen Rajman</h1>
        <p class="class-line">Engineering Manager</p>
        <p class="epithet">Problem solver, coffee enjoyer, 10x human</p>
        <dl class="id-fields">
          <div><dt>Origin</dt><dd>Durban, South Africa</dd></div>
          <div><dt>Base</dt><dd>Cape Town, South Africa</dd></div>
          <div><dt>Background</dt><dd>Software engineering</dd></div>
          <div><dt>Faction</dt><dd>Derivco</dd></div>
        </dl>
        <div class="xp">
          <div class="xp-track"><div class="xp-fill"></div></div>
          <p class="xp-label">Experience: 11 years in software, since 2015</p>
        </div>
      </div>

      <ul class="attributes" aria-label="Attributes">
        {ATTRIBUTES.map(({ name, score }) => (
          <li class="attribute">
            <svg class="gauge" viewBox="0 0 64 64" aria-hidden="true">
              <circle class="gauge-track" cx="32" cy="32" r={GAUGE_R}
                stroke-dasharray={`${GAUGE_ARC} ${2 * Math.PI * GAUGE_R}`} />
              <circle class="gauge-fill" cx="32" cy="32" r={GAUGE_R}
                stroke-dasharray={`${(GAUGE_ARC * score / 20).toFixed(1)} ${2 * Math.PI * GAUGE_R}`} />
            </svg>
            <span class="attr-score">{score}</span>
            <span class="attr-name">{name}</span>
            <span class="attr-mod">{mod(score) >= 0 ? '+' : ''}{mod(score)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="panel abilities" id="abilities" aria-labelledby="abilities-head">
      <h2 class="section-head" id="abilities-head">Abilities</h2>
      <p class="section-note">Five schools, each read top to bottom in the order the ranks were earned.</p>
      <div class="tree-scroll">
        <svg class="skill-tree" viewBox={`0 0 ${COL_W * SCHOOLS.length + 40} ${treeHeight}`}
             role="img" aria-label="Skill tree: Engineering, Frameworks, Cloud and tooling, Quality and Leadership, each a column of ranks">
          {SCHOOLS.map((school, c) => {
            const cx = c * COL_W + 34;
            const last = school.nodes.length - 1;
            return (
              <g class="school">
                <text class="school-name" x={c * COL_W + 12} y="24">{school.name}</text>
                <line class="school-rule" x1={c * COL_W + 12} y1="34" x2={(c + 1) * COL_W - 20} y2="34" />
                <line class="school-spine" x1={cx} y1={TOP} x2={cx} y2={TOP + ROW_H * last} />
                {school.nodes.map(([label, rank], r) => {
                  const cy = TOP + ROW_H * r;
                  return (
                    <g class={`node rank-${rank}`}>
                      <polygon points={hexPoints(cx, cy, HEX_R)} />
                      <text class="node-rank" x={cx} y={cy + 4.5}>{rank}</text>
                      <text class="node-label" x={cx + HEX_R + 12} y={cy + 4.5}>{label}</text>
                      <title>{label}: {RANK[rank]}</title>
                    </g>
                  );
                })}
              </g>
            );
          })}
        </svg>
      </div>
      <ul class="rank-key" aria-hidden="true">
        <li><span class="key-hex rank-3"></span>Mastered</li>
        <li><span class="key-hex rank-2"></span>Proficient</li>
        <li><span class="key-hex rank-1"></span>Learning</li>
      </ul>
    </section>

    <section class="panel quests" id="quests" aria-labelledby="quests-head">
      <h2 class="section-head" id="quests-head">Quest log</h2>

      <h3 class="quest-group">Active</h3>
      <article class="quest active">
        <h4>Engineering Manager</h4>
        <p class="q-meta"><span>Derivco, Cape Town</span><span>June 2024 to present</span></p>
        <p>Leads two full-stack teams that own the Player Account Management and Player Balance Ledger product suites. Full ownership from idea to roadmap to delivery to support.</p>
        <ul class="objectives">
          <li class="done">Joined as Senior SDET; promoted to Engineering Manager in May 2025</li>
          <li class="done">Over 100 billion requests a month at 99.98% uptime</li>
          <li class="done">Compliant with EU GDPR and ISO 27001</li>
          <li class="done">Built AI tooling for change management, audit and support tickets</li>
          <li class="open">Keep the people sharp and the path clear</li>
        </ul>
      </article>

      <h3 class="quest-group">Completed</h3>
      <article class="quest">
        <h4>Senior Software Engineer, Project Lead</h4>
        <p class="q-meta"><span>Entelect, Cape Town</span><span>April 2022 to May 2024</span></p>
        <p>Consulting arc. Technical expertise, leadership and stakeholder management for eBay Mexico, Adevinta, FNZ UK and MunichRe.</p>
        <ul class="objectives">
          <li class="done">Acting team lead for eBay Mexico, Adevinta and FNZ UK</li>
          <li class="done">Project lead at MunichRe: team lead and senior engineer in one</li>
          <li class="done">Four fifths of the time hands-on, mostly in insurance</li>
        </ul>
      </article>
      <article class="quest">
        <h4>Senior Software Developer, Technical Lead</h4>
        <p class="q-meta"><span>Derivco, Durban</span><span>January 2015 to March 2022</span></p>
        <p>Where the character was rolled. Technical lead in the Quickfire BackOffice department: large-scale campaign creation and tracking tools, four teams of thirty people across four locations.</p>
        <ul class="objectives">
          <li class="done">Production tester, then developer, then technical lead</li>
          <li class="done">Founded the Campaign Manager Design Board</li>
          <li class="done">Wrote the strategies: branching, test-first automation, monitoring, feature flags</li>
        </ul>
      </article>
      <article class="quest">
        <h4>Managing Editor</h4>
        <p class="q-meta"><span>EGMR</span><span>February 2011 to December 2015</span></p>
        <p>The games-media arc. Reviews, columns, podcasts, press badges, and deadlines that did not move.</p>
      </article>
    </section>

    <section class="panel codex" id="codex" aria-labelledby="codex-head">
      <h2 class="section-head" id="codex-head">Codex</h2>
      <ul class="codex-list">
        <li><span class="codex-year">2014</span><span class="codex-body"><strong>Bachelor of Commerce, Information Systems and Technology</strong> University of KwaZulu-Natal, Durban</span></li>
        <li><span class="codex-year">2015</span><span class="codex-body"><strong>Certified Tester, Foundation Level</strong> ISTQB</span></li>
        <li><span class="codex-year">2018</span><span class="codex-body"><strong>Crucial Conversations</strong> Derivco</span></li>
        <li><span class="codex-year">2019</span><span class="codex-body"><strong>Personal Mastery</strong> Derivco</span></li>
        <li><span class="codex-year">2024</span><span class="codex-body"><strong>Legitimate Leadership</strong> Entelect</span></li>
      </ul>
    </section>

    <!-- Companion: the Badger keeps his seat on the rail at wide widths, and
         travels here from the scene via the cross-document view transition. -->
    <div class="sheet-portrait" aria-hidden="true">
      <img src="/badger-up.png" alt="" />
      <p class="companion-caption">Companion</p>
    </div>

    <footer class="sheet-foot">
      <a href="https://www.linkedin.com/in/caveshen" class="contact-link">LinkedIn</a>
      <a href="https://github.com/caveshen" class="contact-link">GitHub</a>
      <a href="/cv.pdf" class="contact-link">Download CV</a>
    </footer>

  </main>
</Base>

<style is:global>
  body { background: var(--sheet-bg); }

  /* ── Menu bar ── */
  .menu-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 0.8rem clamp(1rem, 4vw, 3rem);
    background: rgba(6, 10, 18, 0.85);
    border-bottom: 1px solid var(--holo-dim);
    backdrop-filter: blur(6px);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    text-decoration: none;
    transition: color var(--t-micro);
  }
  .back-link kbd,
  .menu-bar kbd {
    font-family: var(--hud);
    font-size: 0.7rem;
    padding: 0.1em 0.4em;
    color: var(--holo);
    border: 1px solid var(--holo-dim);
    border-radius: 3px;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--gold-bright); }
  .menu-tabs {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
    margin-right: auto;
  }
  .menu-tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 1rem;
    font-family: var(--hud);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--t-micro), border-color var(--t-micro);
  }
  .menu-tabs a:hover, .menu-tabs a:focus-visible {
    color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
  }
  .back-link:focus-visible {
    outline: 1px solid var(--holo);
    outline-offset: 3px;
  }
  .menu-tabs a:focus-visible {
    outline: 1px solid var(--holo);
    outline-offset: 3px;
  }
  .download-btn:focus-visible {
    outline: 1px solid var(--holo);
    outline-offset: 3px;
  }
  /* The page's one filled control. */
  .download-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 44px;
    padding: 0.4rem 1.1rem;
    font-family: var(--hud);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--btn-primary-ink);
    background: var(--gold);
    text-decoration: none;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    transition: background var(--t-micro);
  }
  .download-btn:hover, .download-btn:focus-visible { background: var(--gold-bright); }
  .download-note {
    font-weight: 600;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  /* ── Record ── */
  .record {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem clamp(1rem, 4vw, 1.5rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .panel {
    padding: 1.5rem clamp(1rem, 3vw, 2rem) 1.75rem;
    background: linear-gradient(180deg, rgba(14, 26, 46, 0.55), rgba(6, 10, 18, 0.55));
    border: 1px solid var(--holo-dim);
    clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
    scroll-margin-top: 5rem;
  }
  .section-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-bright);
    margin-bottom: 1rem;
  }
  .section-head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
  }
  .section-note {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--dim);
    margin: -0.4rem 0 1.2rem;
  }

  /* ── Character ── */
  .character {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 2rem;
    align-items: start;
    scroll-margin-top: 5rem;
  }
  .portrait-frame {
    position: relative;
    width: 150px;
    padding: 6px;
    border: 1px solid var(--holo-dim);
    background: rgba(6, 10, 18, 0.6);
  }
  .head-portrait { display: block; width: 100%; height: auto; }
  .corner { position: absolute; width: 14px; height: 14px; border: 2px solid var(--gold); }
  .corner.tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .corner.tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .corner.bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .corner.br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  /* Level: a gold diamond on the frame's corner. The diamond is a rotated
     pseudo-element so the text inside stays upright. */
  .level-badge {
    position: absolute;
    right: -12px;
    bottom: -14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--btn-primary-ink);
  }
  .level-badge::before {
    content: '';
    position: absolute;
    inset: 8px;
    background: var(--gold-bright);
    rotate: 45deg;
    z-index: -1;
    box-shadow: 0 0 14px rgba(255, 196, 107, 0.45);
  }
  .level-badge .level-word {
    font-family: var(--hud);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1px;
  }

  .identity h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    letter-spacing: 0.05em;
    line-height: 1.1;
  }
  .class-line {
    font-family: var(--hud);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--holo);
    margin-top: 0.35rem;
  }
  .epithet {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--dim);
    margin-top: 0.3rem;
  }
  .id-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.7rem 1.5rem;
    margin-top: 1.2rem;
  }
  .id-fields dt {
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--holo);
  }
  .id-fields dd {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--text);
  }
  .xp { margin-top: 1.2rem; }
  .xp-track {
    height: 6px;
    background: rgba(6, 10, 18, 0.8);
    border: 1px solid var(--holo-dim);
    overflow: hidden;
  }
  .xp-fill { --xp: 78%; width: var(--xp); height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-bright)); }
  .xp-label {
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 0.4rem;
  }

  .attributes {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
    border-top: 1px solid var(--holo-dim);
  }
  .attribute {
    position: relative;
    display: grid;
    grid-template-rows: 64px auto auto;
    justify-items: center;
    text-align: center;
  }
  .gauge { width: 64px; height: 64px; rotate: 135deg; }
  .gauge circle { fill: none; stroke-width: 3; stroke-linecap: butt; }
  .gauge-track { stroke: var(--holo-dim); }
  .gauge-fill { stroke: var(--gold-bright); }
  .attr-score {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .attr-name {
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--holo);
    margin-top: 0.2rem;
  }
  .attr-mod {
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--dim);
  }

  /* ── Abilities: the skill tree ── */
  .tree-scroll { overflow-x: auto; }
  .skill-tree { display: block; width: 100%; min-width: 860px; height: auto; }
  .school-name {
    font-family: var(--hud);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--gold-bright);
  }
  .school-rule { stroke: var(--gold); stroke-opacity: 0.5; }
  .school-spine { stroke: var(--holo-dim); stroke-width: 2; }
  .node polygon { stroke-width: 1.5; }
  .node.rank-3 polygon { fill: var(--gold-bright); stroke: var(--gold-bright); }
  .node.rank-2 polygon { fill: var(--navy); stroke: var(--gold); }
  .node.rank-1 polygon { fill: none; stroke: var(--holo); stroke-dasharray: 4 3; }
  .node-rank {
    font-family: var(--hud);
    font-weight: 700;
    font-size: 13px;
    text-anchor: middle;
    fill: var(--text);
  }
  .node.rank-3 .node-rank { fill: #060a12; }
  .node-label {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 17px;
    fill: var(--text);
  }
  .rank-key {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    font-family: var(--hud);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .rank-key li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .key-hex {
    width: 12px;
    height: 12px;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  .key-hex.rank-3 { background: var(--gold-bright); }
  .key-hex.rank-2 { background: var(--gold); }
  .key-hex.rank-1 { background: var(--holo); }

  /* ── Quest log ── */
  .quest-group {
    font-family: var(--hud);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--holo);
    margin: 1.25rem 0 0.5rem;
  }
  .quest {
    position: relative;
    padding: 0.9rem 0 0.9rem 1.6rem;
    border-left: 1px solid var(--holo-dim);
  }
  .quest::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 1.35rem;
    width: 10px;
    height: 10px;
